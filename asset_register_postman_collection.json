{
  "info": {
    "name": "Asset API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "assetId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Asset",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Dell Laptop\",\n    \"type\": \"Electronics\",\n    \"description\": \"Office laptop\",\n    \"tags\": [\"office\", \"computer\"],\n    \"createdBy\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/assets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    const data = pm.response.json();",
              "    if (data.id) pm.collectionVariables.set('assetId', data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List Active Assets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/assets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets"
          ]
        }
      }
    },
    {
      "name": "Filter Assets by Type",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/assets?type=Electronics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets"
          ],
          "query": [
            {
              "key": "type",
              "value": "Electronics"
            }
          ]
        }
      }
    },
    {
      "name": "Filter Assets by Tag",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/assets?tag=office",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets"
          ],
          "query": [
            {
              "key": "tag",
              "value": "office"
            }
          ]
        }
      }
    },
    {
      "name": "Get One Asset",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/assets/{{assetId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets",
            "{{assetId}}"
          ]
        }
      }
    },
    {
      "name": "Update Asset",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Dell Latitude Laptop\",\n    \"updatedBy\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/assets/{{assetId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets",
            "{{assetId}}"
          ]
        }
      }
    },
    {
      "name": "Add Tags to Asset",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"tags\": [\"finance\", \"assigned\"],\n    \"updatedBy\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/assets/{{assetId}}/tags",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets",
            "{{assetId}}",
            "tags"
          ]
        }
      }
    },
    {
      "name": "Deactivate Asset",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/assets/{{assetId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets",
            "{{assetId}}"
          ]
        }
      }
    }
  ]
}
